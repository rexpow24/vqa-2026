# Copy to docker/.env and edit only if you need to. Every value here has a
# working default in docker-compose.yml; this file exists to document them.

VLM_PORT=8080

# Files under ./models (bind-mounted read-only at /models).
# Hashes are recorded in models/SHA256SUMS -- verify before reporting a bug.
VLM_MODEL=Qwen3VL-2B-Instruct-Q4_K_M.gguf
VLM_MMPROJ=mmproj-Qwen3VL-2B-Instruct-F16.gguf
VLM_ALIAS=qwen3-vl-2b

# 6 GB card. Raise VLM_CTX only after measuring -- vision tokens scale with the
# number of images per request, so 4 keyframes cost roughly 4x one image.
VLM_CTX=4096
VLM_NGL=99
